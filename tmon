#
# _tmon_ps_help - Show help for ps command
#
_tmon_ps_help() {
  printf '%s\n' 'tmon ps [--raw] [-S | --session SESSION] [-h | --help]' \
                'List all monitored files.' \
                '' \
                '  -S, --session SESSION   Show only specified session (default: all sessions).' \
                '      --raw               Show raw information.' \
                '  -h, --help              Display this help and exit.' \
                '' \
                'Examples:' \
                '  tmon ps                 List monitors from all sessions.' \
                '  tmon ps -S mysession@0  List monitors from specific session.' \
                ''
  exit
}

#
# tmon_ps - List monitors
#
tmon_ps() {
  local ARGUMENTS
  ARGUMENTS=$(getopt -o "hS:" -l "raw,help,session:" -- "$@" 2>/dev/null) || _tmon_ps_help
  eval "set -- ${ARGUMENTS}"
  
  local session_id=""
  local raw_info=false
  
  while [ $# -gt 0 ]; do
    case "$1" in
      --raw)
        raw_info=true
        shift
        ;;
      -S|--session)
        session_id="$2"
        shift 2
        ;;
      -h|--help)
        _tmon_ps_help
        ;;
      --)
        shift
        ;;
      *)
        _tmon_ps_help
        ;;
    esac
  done
  
  # Resolve session (empty means all sessions)
  session_id=$(_resolve_session_ps "$session_id")
  
  if [ -n "$session_id" ]; then
    # Show specific session
    _tmon_ps_session "$session_id" "$raw_info"
  else
    # Show all sessions
    _tmon_ps_all "$raw_info"
  fi
}

#
# _tmon_ps_session - Show monitors for a specific session
#
_tmon_ps_session() {
  local session_id="$1"
  local raw_info="$2"
  local session_name
  
  session_name=$(_get_session_name_from_id "$session_id")
  
  if ! _session_exists_in_tmux "$session_id"; then
    echo "Session '$session_id' not found." >&2
    return 1
  fi
  
  # Update activity
  _register_session "$session_id" "active"
  
  if [ "$raw_info" == true ]; then
    _get_monitored_files "$session_id" | while IFS= read -r line || [ -n "$line" ]; do
      IFS="|" read -r file title pid tmp dead <<< "$line"
      echo "${session_id}|${tmp}|${file}|${title}|${pid}|${dead}"
    done
  else
    local info=()
    while IFS= read -r line || [ -n "$line" ]; do
      IFS="|" read -r file title pid tmp dead <<< "$line"
      local status
      if [ -n "$dead" ]; then status=closed; else status=open; fi
      if [ -z "$tmp" ]; then tmp=" "; fi
      if [ -z "$file" ]; then file=" "; fi
      if [ -z "$title" ]; then title=" "; fi
      if [ -z "$pid" ]; then pid=" "; fi
      info=("${info[@]}" "$session_id|$tmp|$status|$pid|$title|$file")
    done < <(_get_monitored_files "$session_id")
    
    if [ "${#info[@]}" -gt 0 ]; then
      info=("Session|ID|Status|PID|Title|File" "${info[@]}")
      for line in "${info[@]}"; do
        echo "$line"
      done | column -t -s "|"
      echo ""
    fi
  fi
}

#
# _tmon_ps_all - Show monitors for all sessions
#
_tmon_ps_all() {
  local raw_info="$1"
  
  _init_sessions_registry
  _cleanup_dead_sessions
  
  local sessions
  sessions=$(_list_sessions)
  
  if [ -z "$sessions" ]; then
    echo "No active monitors."
    return
  fi
  
  if [ "$raw_info" == true ]; then
    # Raw mode: output each session's data directly
    while IFS= read -r session_id; do
      if [ -n "$session_id" ]; then
        _get_monitored_files "$session_id" | while IFS= read -r line || [ -n "$line" ]; do
          IFS="|" read -r file title pid tmp dead <<< "$line"
          echo "${session_id}|${tmp}|${file}|${title}|${pid}|${dead}"
        done
      fi
    done <<< "$sessions"
  else
    # Normal mode: collect all data and output with single header
    local all_info=()
    while IFS= read -r session_id; do
      if [ -n "$session_id" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
          IFS="|" read -r file title pid tmp dead <<< "$line"
          local status
          if [ -n "$dead" ]; then status=closed; else status=open; fi
          if [ -z "$tmp" ]; then tmp=" "; fi
          if [ -z "$file" ]; then file=" "; fi
          if [ -z "$title" ]; then title=" "; fi
          if [ -z "$pid" ]; then pid=" "; fi
          all_info=("${all_info[@]}" "$session_id|$tmp|$status|$pid|$title|$file")
        done < <(_get_monitored_files "$session_id")
      fi
    done <<< "$sessions"
    
    if [ "${#all_info[@]}" -gt 0 ]; then
      all_info=("Session|ID|Status|PID|Title|File" "${all_info[@]}")
      for line in "${all_info[@]}"; do
        echo "$line"
      done | column -t -s "|"
    else
      echo "No active monitors."
    fi
  fi
}

