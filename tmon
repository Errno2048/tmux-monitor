#
# tmon_monitor - Show monitors in panes
#
tmon_monitor() {
  local ARGUMENTS
  ARGUMENTS=$(getopt -o "p,s,i,a,S:,h" -l "preserve,sudo,id,all,session:,help" -- "$@" 2>/dev/null) || _tmon_monitor_help
  eval "set -- ${ARGUMENTS}"

  local args=()
  local use_sudo=false
  local clear=true
  local by_id=false
  local show_all=false
  local session_id=""
  
  while [ $# -gt 0 ]; do
    case "$1" in
      -p|--preserve)
        clear=false
        shift
        ;;
      -s|--sudo)
        use_sudo=true
        shift
        ;;
      -i|--id)
        by_id=true
        shift
        ;;
      -a|--all)
        show_all=true
        shift
        ;;
      -S|--session)
        session_id="$2"
        shift 2
        ;;
      -h|--help)
        _tmon_monitor_help
        ;;
      --)
        shift
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done
  
  # Resolve session
  local resolved_session
  _resolve_session_created=false
  resolved_session=$(_resolve_session_open "$session_id" true)
  
  if [ -z "$resolved_session" ]; then
    echo "Failed to resolve session." >&2
    return 1
  fi
  
  # Check if session was created (output starts with CREATED:)
  if echo "$resolved_session" | grep -q "^CREATED:"; then
    _resolve_session_created=true
    session_id=$(echo "$resolved_session" | sed 's/^CREATED://')
  else
    session_id="$resolved_session"
  fi
  
  _prepare_session_tmp "$session_id"
  _register_session "$session_id" "active"
  
  local session_name
  session_name=$(_get_session_name_from_id "$session_id")
  
  # Clear panes if requested
  if [ "$clear" == true ]; then
    _kill_all_panes_except_first "$session_id"
  fi
  
  # Collect target files to monitor
  local target_files=()
  local lines=()
  local open_dead=false
  
  if [ "$by_id" == true ] || [ "$show_all" == true ]; then
    # Open by ID or all
    while IFS= read -r line || [ -n "$line" ]; do
      IFS="|" read -r file title pid tmp dead <<< "$line"
      local success=false
      
      if [ "$show_all" == true ]; then
        success=true
      else
        for monitor_id in "${args[@]}"; do
          if [ "$monitor_id" == "$tmp" ]; then
            success=true
            break
          fi
        done
      fi
      
      if [ "$use_sudo" != true ] && [ ! -r "$file" ]; then
        success=false
      fi
      
      if [ "$success" == true ]; then
        if [ -z "$title" ]; then title=$(basename "$file"); fi
        if [ -n "$dead" ]; then open_dead=true; fi
        target_files=("${target_files[@]}" "$file|$title")
        lines=("${lines[@]}" "$file|$title|$pid|$tmp|")
      else
        lines=("${lines[@]}" "$line")
      fi
    done < <(_get_monitored_files "$session_id")
    
    # Reopen dead monitors if needed
    if [ "$open_dead" == true ]; then
      local monitor_file monitor_tmpfile
      monitor_file=$(_get_monitor_file "$session_id")
      monitor_tmpfile="${monitor_file}.tmp"
      
      > "$monitor_tmpfile"
      for line in "${lines[@]}"; do
        echo "$line" >> "$monitor_tmpfile"
      done
      
      mv -f "$monitor_tmpfile" "$monitor_file"
    fi
  else
    # Open last N monitors
    local num_files
    if [ -z "${args[0]}" ]; then
      num_files=2
    else
      num_files="${args[0]}"
    fi
    
    while IFS= read -r line || [ -n "$line" ]; do
      IFS="|" read -r file title pid tmp dead <<< "$line"
      if [ -n "$dead" ]; then continue; fi
      if [ "$use_sudo" != true ] && [ ! -r "$file" ]; then continue; fi
      if [ -z "$title" ]; then title=$(basename "$file"); fi
      lines=("$file|$title" "${lines[@]}")
    done < <(_get_monitored_files "$session_id")
    
    for line in "${lines[@]}"; do
      IFS="|" read -r file title <<< "$line"
      target_files=("$file|$title" "${target_files[@]}")
      if [ ${#target_files[@]} -ge "$num_files" ]; then
        break
      fi
    done
  fi
  
  # Create panes for target files
  local i=0
  for file_title in "${target_files[@]}"; do
    IFS="|" read -r file title <<< "$file_title"
    
    if [ -f "$file" ]; then
      local tmux_args
      if [ $i -gt 0 ]; then
        tmux_args="-v"
      else
        tmux_args="-h -p 50"
      fi
      
      local new_pane_index
      if [ "$use_sudo" == true ]; then
        new_pane_index=$(_split_window "$tmux_args" "\"$sudo\" tail -n +0 -f \"${file}\"" "$session_id")
      else
        new_pane_index=$(_split_window "$tmux_args" "tail -n +0 -f \"${file}\"" "$session_id")
      fi
      
      i=$(expr $i + 1)
      _select_pane "$new_pane_index" "$session_id" "$(_get_pane_title "$title" "$session_id")"
    fi
  done
  
  _set_layout "$session_id"
  
  # Attach if we created a new session and we're not in tmux
  if [ "$_resolve_session_created" == true ] && [ "$(in_session)" == "0" ]; then
    _attach_session "$session_id"
  fi
}

