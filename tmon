#
# tmon_exec - Execute command with output capture
#
tmon_exec() {
  local args=()
  local use_sudo=false
  local detached=false
  local stdout_file=""
  local stderr_file=""
  local log_stdout=false
  local log_stderr=false
  local overwrite_title=false
  local append=false
  local _title=""
  local session_id=""
  
  while [ $# -gt 0 ]; do
    case "$1" in
      -s|--sudo)
        use_sudo=true
        shift
        ;;
      -d|--detach)
        detached=true
        shift
        ;;
      -t|--title)
        overwrite_title=true
        _title="$2"
        shift 2
        ;;
      -h|--help)
        _tmon_exec_help
        ;;
      -o)
        log_stdout=true
        shift
        ;;
      -e)
        log_stderr=true
        shift
        ;;
      --stdout)
        stdout_file="$2"
        shift 2
        ;;
      --stderr)
        stderr_file="$2"
        shift 2
        ;;
      -a|--append)
        append=true
        shift
        ;;
      -S|--session)
        session_id="$2"
        shift 2
        ;;
      --)
        shift
        ;;
      *)
        args+=("$@")
        break
        ;;
    esac
  done
  
  if [ ${#args[@]} -eq 0 ]; then
    _tmon_exec_help
  fi
  
  # Resolve session
  local resolved_session
  _resolve_session_created=false
  resolved_session=$(_resolve_session_open "$session_id" true)
  
  if [ -z "$resolved_session" ]; then
    echo "Failed to resolve session." >&2
    return 1
  fi
  
  # Check if session was created (output starts with CREATED:)
  if echo "$resolved_session" | grep -q "^CREATED:"; then
    _resolve_session_created=true
    session_id=$(echo "$resolved_session" | sed 's/^CREATED://')
  else
    session_id="$resolved_session"
  fi
  
  _prepare_session_tmp "$session_id"
  _register_session "$session_id" "active"
  
  # Get temp index and set up output files
  local tmp_index
  tmp_index=$(_get_tmp_index "$session_id")
  
  if [ -n "$tmp_index" ]; then
    touch "$(_get_tmp_stdout "$tmp_index" "$session_id")"
  fi
  
  if [ -z "$stdout_file" ] || [ -z "$stderr_file" ]; then
    if [ -z "$tmp_index" ]; then
      if [ -z "$stdout_file" ]; then stdout_file=nohup.out; fi
      if [ -z "$stderr_file" ]; then stderr_file=nohup.err; fi
    else
      stdout_file=$(_get_tmp_stdout "$tmp_index" "$session_id")
      stderr_file=$(_get_tmp_stderr "$tmp_index" "$session_id")
    fi
  fi
  
  # Build and execute command
  local args_string
  args_string=$(_escape_monitor_arg "${args[*]}")
  
  local redirect
  if [ "$append" == true ]; then
    redirect=">>\"$stdout_file\" 2>>\"$stderr_file\""
  else
    redirect=">\"$stdout_file\" 2>\"$stderr_file\""
  fi
  
  if [ "$use_sudo" == true ]; then
    ("$sudo" nohup sh -c "${args[*]} ${redirect}") >/dev/null 2>/dev/null &
  else
    (nohup sh -c "${args[*]} ${redirect}") >/dev/null 2>/dev/null &
  fi
  
  local pid=$!
  
  # Create panes for output (unless detached)
  if [ "$detached" != true ]; then
    local session_name
    session_name=$(_get_session_name_from_id "$session_id")
    
    if [ "$log_stderr" == true ]; then
      touch "$stderr_file"
      local title
      if [ "$overwrite_title" == true ]; then
        title="stderr ${_title}"
      else
        title="stderr $args_string"
      fi
      
      local stderr_pane_index
      stderr_pane_index=$(_split_window "-v" "tail -n +0 -f \"${stderr_file}\"" "$session_id")
      _select_pane "$stderr_pane_index" "$session_id" "$(_get_pane_title "$title" "$session_id")"
      
      local abspath
      abspath=$(_abspath "$stderr_file")
      _monitor_append "$abspath" "$title" "$pid" "$tmp_index" "" "$session_id"
    fi
    
    if [ "$log_stdout" == true ]; then
      touch "$stdout_file"
      local title
      if [ "$overwrite_title" == true ]; then
        title="stdout ${_title}"
      else
        title="stdout $args_string"
      fi
      
      local stdout_pane_index
      stdout_pane_index=$(_split_window "-v" "tail -n +0 -f \"${stdout_file}\"" "$session_id")
      _select_pane "$stdout_pane_index" "$session_id" "$(_get_pane_title "$title" "$session_id")"
      
      local abspath
      abspath=$(_abspath "$stdout_file")
      _monitor_append "$abspath" "$title" "$pid" "$tmp_index" "" "$session_id"
    fi
    
    _set_layout "$session_id"
    
    # Attach if we created a new session and we're not in tmux
    if [ "$_resolve_session_created" == true ] && [ "$(in_session)" == "0" ]; then
      _attach_session "$session_id"
    fi
  fi
  
  _monitor_file_check "$session_id"
}

