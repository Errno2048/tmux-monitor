#
# tmon_open - Open file monitors
#
tmon_open() {
  local ARGUMENTS
  ARGUMENTS=$(getopt -o "s,c,C:,f,t:,d,S:,h" -l "sudo,create,cut:,full,title:,detach,session:,help" -- "$@" 2>/dev/null) || _tmon_open_help
  eval "set -- ${ARGUMENTS}"

  local args=()
  local use_sudo=false
  local detached=false
  local absolute_path=false
  local create=false
  local overwrite_title=false
  local title=""
  local session_id=""
  local cut=""
  
  while [ $# -gt 0 ]; do
    case "$1" in
      -s|--sudo)
        use_sudo=true
        shift
        ;;
      -d|--detach)
        detached=true
        shift
        ;;
      -c|--create)
        create=true
        shift
        ;;
      -C|--cut)
        cut="$2"
        shift 2
        ;;
      -f|--full)
        absolute_path=true
        shift
        ;;
      -t|--title)
        overwrite_title=true
        title="$2"
        shift 2
        ;;
      -S|--session)
        session_id="$2"
        shift 2
        ;;
      -h|--help)
        _tmon_open_help
        ;;
      --)
        shift
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  # Validate cut parameter
  if expr "$cut" : '^[0-9]\+$' >/dev/null; then
    cut=" | cut -c \"-$cut\""
  else
    cut=""
  fi

  # Resolve session
  local resolved_session
  _resolve_session_created=false
  resolved_session=$(_resolve_session_open "$session_id" true)
  
  if [ -z "$resolved_session" ]; then
    echo "Failed to resolve session." >&2
    return 1
  fi
  
  # Check if session was created (output starts with CREATED:)
  if echo "$resolved_session" | grep -q "^CREATED:"; then
    _resolve_session_created=true
    session_id=$(echo "$resolved_session" | sed 's/^CREATED://')
  else
    session_id="$resolved_session"
  fi
  
  # Prepare session
  _prepare_session_tmp "$session_id"
  _register_session "$session_id" "active"
  
  local session_name
  session_name=$(_get_session_name_from_id "$session_id")
  
  # Process each file
  local i=0
  while [ $i -lt ${#args[@]} ]; do
    local file="${args[$i]}"
    
    if [ "$create" == true ] || [ -f "$file" ]; then
      local abspath
      abspath=$(_abspath "$file")
      
      # Create file if needed
      if [ "$create" == true ] && [ ! -e "$file" ]; then
        if [ "$use_sudo" == true ]; then
          "$sudo" touch "$file"
        else
          touch "$file"
        fi
      fi
      
      # Create pane (unless detached)
      if [ "$detached" != true ]; then
        local new_pane_index
        
        if [ "$use_sudo" == true ]; then
          new_pane_index=$(_split_window "-v" "\"$sudo\" tail -n +0 -f \"${file}\"${cut}" "$session_id")
        else
          if [ ! -r "$file" ]; then
            echo "Cannot read file: $file" >&2
            i=$(expr $i + 1)
            continue
          fi
          new_pane_index=$(_split_window "-v" "tail -n +0 -f \"${file}\"${cut}" "$session_id")
        fi
        
        # Set title
        if [ "$overwrite_title" == false ]; then
          if [ "$absolute_path" == true ]; then
            title="$abspath"
          else
            title=$(basename "$file")
          fi
        fi
        
        # Select the newly created pane and set its title
        local pane_title
        pane_title=$(_get_pane_title "$title" "$session_id")
        _select_pane "$new_pane_index" "$session_id" "$pane_title"
      fi
      
      # Register monitor
      local tmp_index
      tmp_index=$(_get_tmp_index "$session_id")
      if [ -n "$tmp_index" ]; then
        touch "$(_get_tmp_stdout "$tmp_index" "$session_id")"
      fi
      
      _monitor_append "$abspath" "$title" "" "$tmp_index" "" "$session_id"
    else
      echo "File not found: $file" >&2
    fi
    
    i=$(expr $i + 1)
  done
  
  _monitor_file_check "$session_id"
  
  # Set layout and attach if needed
  if [ "$detached" != true ]; then
    _set_layout "$session_id"
    
    # Attach if we created a new session and we're not in tmux
    if [ "$_resolve_session_created" == true ] && [ "$(in_session)" == "0" ]; then
      _attach_session "$session_id"
    fi
  fi
}


