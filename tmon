#
# tmon_kill - Kill monitors
#
tmon_kill() {
  local ARGUMENTS
  ARGUMENTS=$(getopt -o "t,f,p,P,s,ar,h,S:" -l "title,file,pid,process,sudo,all,regex,help,full-match,preserve,session:" -- "$@" 2>/dev/null) || _tmon_kill_help
  eval "set -- ${ARGUMENTS}"

  local args=()
  local use_sudo=false
  local use_name=false
  local use_path=false
  local use_pid=false
  local kill=false
  local clear_all=false
  local regex=false
  local full_match=false
  local kill_panes=true
  local session_id=""
  
  while [ $# -gt 0 ]; do
    case "$1" in
      -t|--title)
        use_name=true
        shift
        ;;
      -f|--file)
        use_path=true
        shift
        ;;
      -p|--pid)
        use_pid=true
        shift
        ;;
      --full-match)
        full_match=true
        shift
        ;;
      -r|--regex)
        regex=true
        shift
        ;;
      -P|--process)
        kill=true
        shift
        ;;
      -s|--sudo)
        use_sudo=true
        shift
        ;;
      --preserve)
        kill_panes=false
        shift
        ;;
      -a|--all)
        clear_all=true
        shift
        ;;
      -S|--session)
        session_id="$2"
        shift 2
        ;;
      -h|--help)
        _tmon_kill_help
        ;;
      --)
        shift
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done
  
  # Resolve session (kill/clear never creates new sessions)
  local resolved_session
  resolved_session=$(_resolve_session_kill_clear "$session_id")
  
  if [ -z "$resolved_session" ]; then
    echo "No session found." >&2
    return 1
  fi
  
  session_id="$resolved_session"
  _register_session "$session_id" "active"
  
  local session_name
  session_name=$(_get_session_name_from_id "$session_id")
  
  _prepare_session_tmp "$session_id"
  
  local monitor_file monitor_tmpfile
  monitor_file=$(_get_monitor_file "$session_id")
  monitor_tmpfile="${monitor_file}.tmp"
  
  # Initialize files
  if [ ! -f "$monitor_file" ]; then
    if [ -f "$monitor_tmpfile" ]; then
      mv -f "$monitor_tmpfile" "$monitor_file"
    else
      touch "$monitor_file"
    fi
  else
    rm -f "$monitor_tmpfile"
  fi
  
  # Handle clear all
  if [ "$clear_all" == true ]; then
    _monitor_clear "$session_id"
    
    if [ "$kill" == true ]; then
      while IFS= read -r line || [ -n "$line" ]; do
        if [ -z "$(echo "$line" | tr -d '[:space:]')" ]; then continue; fi
        
        local file title pid tmp dead
        IFS="|" read -r file title pid tmp dead <<< "$line"
        
        if [ -n "$pid" ]; then
          local child_pid
          child_pid=$(pgrep -P "$pid" || echo "$pid")
          if [ "$use_sudo" == true ]; then
            _kill_process "\"$sudo\" kill" "$child_pid" "$pid"
          else
            _kill_process kill "$child_pid" "$pid"
          fi
        fi
      done < <(cat "$monitor_file" 2>/dev/null; echo)
    fi
    
    if [ "$kill_panes" == true ]; then
      _kill_all_panes_except_first "$session_id"
      _set_layout "$session_id"
    fi
    
    > "$monitor_file"
    return
  fi
  
  # Process individual kills
  while IFS= read -r line || [ -n "$line" ]; do
    if [ -z "$(echo "$line" | tr -d '[:space:]')" ]; then continue; fi
    
    local file title pid tmp dead
    IFS="|" read -r file title pid tmp dead <<< "$line"
    
    # Handle already dead entries
    if [ -n "$dead" ]; then
      if [ "$kill" == true ] && [ -n "$pid" ]; then
        local child_pid
        child_pid=$(pgrep -P "$pid" || echo "$pid")
        if [ "$use_sudo" == true ]; then
          _kill_process "\"$sudo\" kill" "$child_pid" "$pid"
        else
          _kill_process kill "$child_pid" "$pid"
        fi
      fi
      # Keep the dead entry in the file
      echo "$line" >> "$monitor_tmpfile"
      continue
    fi
    
    # Check for match
    local matched=false
    local target
    
    if [ "$use_name" == true ] || [ "$use_path" == true ]; then
      if [ "$use_name" == true ]; then
        target="$title"
      else
        target="$file"
      fi
      
      for value in "${args[@]}"; do
        if [ "$full_match" == true ]; then
          if [ "$regex" == true ]; then
            if echo "$target" | grep -E -q "^${value}$"; then
              matched=true
              break
            fi
          else
            if [ "$target" == "$value" ]; then
              matched=true
              break
            fi
          fi
        else
          if [ "$regex" == true ]; then
            if echo "$target" | grep -qE "$value"; then
              matched=true
              break
            fi
          else
            if expr "$target" : ".*${value}" >/dev/null; then
              matched=true
              break
            fi
          fi
        fi
      done
    else
      if [ "$use_pid" == true ]; then
        target="$pid"
      else
        target="$tmp"
      fi
      
      if [ -n "$target" ]; then
        for value in "${args[@]}"; do
          if [ "$target" == "$value" ]; then
            matched=true
            break
          fi
        done
      fi
    fi
    
    if [ "$matched" == true ]; then
      local killed=$kill
      
      if [ "$kill" == true ] && [ -n "$pid" ]; then
        local child_pid
        child_pid=$(pgrep -P "$pid" || echo "$pid")
        if [ "$use_sudo" == true ]; then
          if _kill_process "\"$sudo\" kill" "$child_pid" "$pid"; then
            :
          else
            killed=false
          fi
        else
          if _kill_process kill "$child_pid" "$pid"; then
            :
          else
            killed=false
          fi
        fi
      fi
      
      if [ "$killed" == true ] || [ -z "$pid" ]; then
        # Fully killed, clean up temp files
        if [ -n "$tmp" ]; then
          echo "Killed $tmp"
          local tmp_stdout tmp_stderr
          tmp_stdout=$(_get_tmp_stdout "$tmp" "$session_id")
          tmp_stderr=$(_get_tmp_stderr "$tmp" "$session_id")
          rm -f "$tmp_stdout" "$tmp_stderr"
        else
          echo "Killed"
        fi
      else
        # Process still running, mark as dead
        if [ -n "$tmp" ]; then
          echo "Killed $tmp"
        else
          echo "Killed"
        fi
        echo "$file|$title|$pid|$tmp|dead" >> "$monitor_tmpfile"
      fi
      
      # Kill associated panes
      if [ "$kill_panes" == true ] && [ -n "$title" ]; then
        local pane_id
        for pane_id in $(_find_panes_by_title "$title" "$session_id"); do
          _kill_pane "$pane_id" "$session_id"
        done
      fi
    else
      # Not matched, preserve
      echo "$line" >> "$monitor_tmpfile"
    fi
  done < "$monitor_file"
  
  if [ "$kill_panes" == true ]; then
    _set_layout "$session_id"
  fi
  
  # Replace original file with updated version
  if [ -f "$monitor_tmpfile" ]; then
    mv -f "$monitor_tmpfile" "$monitor_file"
  else
    # All entries were processed, create empty file
    : > "$monitor_file"
  fi
}


# ============================================================================
# COMMAND: tmon clear
# Clear all panes except first
# ============================================================================

#
# _tmon_clear_help - Show help for clear command
#
_tmon_clear_help() {
  printf '%s\n' 'tmon clear [-S | --session SESSION] [-h | --help]' \
                'Close all panes but preserve file monitors.' \
                '' \
                '  -S, --session SESSION   Target session (default: current, or latest if outside tmux).' \
                '  -h, --help              Display this help and exit.' \
                '' \
                'Session Selection:' \
                '  - Inside tmux: uses current session' \
                '  - Outside tmux: uses latest session (does not create new)' \
                '' \
                'Examples:' \
                '  tmon clear              Clear current/latest session.' \
                '  tmon clear -S mysess    Clear specific session.' \
                ''
  exit
}

#
# tmon_clear - Clear panes
#
tmon_clear() {
  local ARGUMENTS
  ARGUMENTS=$(getopt -o "hS:" -l "help,session:" -- "$@" 2>/dev/null) || _tmon_clear_help
  eval "set -- ${ARGUMENTS}"
  
  local session_id=""
  
  while [ $# -gt 0 ]; do
    case "$1" in
      -S|--session)
        session_id="$2"
        shift 2
        ;;
      -h|--help)
        _tmon_clear_help
        ;;
      --)
        shift
        ;;
      *)
        _tmon_clear_help
        ;;
    esac
  done
  
  # Resolve session (clear never creates new sessions)
  local resolved_session
  resolved_session=$(_resolve_session_kill_clear "$session_id")
  
  if [ -z "$resolved_session" ]; then
    echo "No session found." >&2
    return 1
  fi
  
  session_id="$resolved_session"
  _register_session "$session_id" "active"
  
  _kill_all_panes_except_first "$session_id"
}

# ============================================================================
# COMMAND: tmon exit
# Exit current tmux session
# ============================================================================

#
# _tmon_exit_help - Show help for exit command
#
_tmon_exit_help() {
  printf '%s\n' 'tmon exit [-h | --help]' \
                'Exit current tmux session.' \
                '' \
                '  -h, --help    Display this help and exit.' \
                ''
  exit
}

#
# tmon_exit - Exit current session
#
tmon_exit() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        _tmon_exit_help
        ;;
      *)
        break
        ;;
    esac
  done
  
  local current_session
  current_session=$(_get_current_session_id)
  
  if [ -n "$current_session" ]; then
    _kill_session "$current_session"
  else
    echo "Not in a tmux session." >&2
    return 1
  fi
}

# ============================================================================
# HELP AND MAIN ENTRY
# ============================================================================

#
# _help - Show main help
#
_help() {
  printf "%s\n" 'tmon COMMAND [...]' \
                '' \
                'A file and process monitor shell script based on tmux.' \
                '' \
                'Commands:' \
                '  session   Manage tmon sessions (list, create, switch, kill).' \
                '  ps        List file monitors from all or specific session.' \
                '  open      Create a file monitor and show file content in a pane.' \
                '  exec      Execute command and capture output in panes.' \
                '  monitor   Show monitored files in panes.' \
                '  kill      Remove file monitors and corresponding panes.' \
                '  clear     Close all panes except first.' \
                '  exit      Exit current tmux session.' \
                '' \
                'Global Options:' \
                '  -S, --session SESSION   Target specific session (see command help for defaults).' \
                '' \
                "Run 'tmon COMMAND --help' for more information on a command." \
                ''
  exit
}

#
# Main entry point
#
main() {
  # Check for help or no arguments
  if [ $# -eq 0 ] || [ "$1" == "-h" ] || [ "$1" == "--help" ] || [ "$1" == "-help" ]; then
    _help
  fi
  
  local subparser="$1"
  shift
  
  case "$subparser" in
    session)
      tmon_session "$@"
      ;;
    ps)
      tmon_ps "$@"
      ;;
    open)
      tmon_open "$@"
      ;;
    exec)
      tmon_exec "$@"
      ;;
    monitor)
      tmon_monitor "$@"
      ;;
    kill)
      tmon_kill "$@"
      ;;
    clear)
      tmon_clear "$@"
      ;;
    exit)
      tmon_exit "$@"
      ;;
    *)
      echo "Unknown command: $subparser" >&2
      _help
      ;;
  esac
}

# Run main function
main "$@"

