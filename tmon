#!/usr/bin/env bash
#
# tmon - tmux-monitor
# A file and process monitoring tool based on tmux with session isolation support
#
# Author: (original author)
# Modified: 2026-03-24 - Added session management and isolation
#

# ============================================================================
# GLOBAL CONFIGURATION
# ============================================================================

# sudo command to use
sudo=sudo

# Base temporary directory for tmon
# Structure: /tmp/tmon/$(whoami)/
#   - sessions              : Session registry file
#   - ${SESSION_ID}/        : Per-session directory
#     - monitor             : Monitor registry for this session
#     - *.out, *.err        : Temporary output files
#
tmp_path="${tmp_path:-/tmp/tmon/$(whoami)}"

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

#
# _abspath - Convert relative path to absolute path
# Arguments:
#   $1 - File path (relative or absolute)
# Returns:
#   Absolute path on stdout, or empty string if path is invalid
#
_abspath() {
  if [ -z "$1" ]; then return; fi
  local dirname basename
  dirname=$(cd "$(dirname "$1")" || exit; pwd)
  basename=$(basename "$1")
  echo "$dirname/$basename"
}

#
# _prepare_tmp - Ensure base temporary directory exists
# Creates the base directory structure at $tmp_path
#
_prepare_tmp() {
  if [ ! -d "$tmp_path" ]; then
    if [ -e "$tmp_path" ]; then rm -f "$tmp_path"; fi
    mkdir -p "$tmp_path"
  fi
}

#
# _check_monitor_arg - Check if any argument contains pipe character
# Arguments:
#   $@ - Arguments to check
# Returns:
#   1 if any argument contains '|', 0 otherwise
#
_check_monitor_arg() {
  while [ $# -gt 0 ]; do
    if echo "$1" | grep -q '|'; then echo 1; return; fi
    shift
  done
  echo 0
}

#
# _escape_monitor_arg - Escape pipe characters in string
# Arguments:
#   $1 - String to escape
# Returns:
#   String with '|' replaced by space
#
_escape_monitor_arg() {
  echo "$1" | sed "s/|/ /g"
}

# ============================================================================
# SESSION MANAGEMENT
# ============================================================================
#
# Session ID format: ${session_name}@${window_id}
# Example: "tmon_12345@0", "my_session@1"
#
# Session Registry Format (pipe-delimited):
#   SESSION_ID|CREATION_TIME|LAST_ACTIVITY|STATUS
#

#
# _get_sessions_file - Get path to sessions registry file
# Returns:
#   Path to sessions registry file
#
_get_sessions_file() {
  echo "${tmp_path}/sessions"
}

#
# _init_sessions_registry - Initialize sessions registry file
# Creates empty sessions file if it doesn't exist
#
_init_sessions_registry() {
  _prepare_tmp
  local sessions_file
  sessions_file=$(_get_sessions_file)
  if [ ! -f "$sessions_file" ]; then
    touch "$sessions_file"
  fi
}

#
# _get_current_session_id - Get session ID of current tmux session
# Returns:
#   Session ID in format "name@window_id", or empty if not in tmux
#
_get_current_session_id() {
  # Check if we're inside tmux
  if [ -z "$TMUX" ]; then
    echo ""
    return
  fi
  
  local session_name window_id
  session_name=$(tmux display-message -p '#{session_name}' 2>/dev/null)
  window_id=$(tmux display-message -p '#{window_id}' 2>/dev/null)
  
  if [ -n "$session_name" ] && [ -n "$window_id" ]; then
    echo "${session_name}@${window_id}"
  else
    echo ""
  fi
}

#
# _get_session_name_from_id - Extract session name from session ID
# Arguments:
#   $1 - Session ID (format: name@window_id)
# Returns:
#   Session name (part before @)
#
_get_session_name_from_id() {
  echo "$1" | cut -d'@' -f1
}

#
# _get_window_id_from_id - Extract window ID from session ID
# Arguments:
#   $1 - Session ID (format: name@window_id)
# Returns:
#   Window ID (part after @)
#
_get_window_id_from_id() {
  echo "$1" | cut -d'@' -f2
}

#
# _session_exists_in_tmux - Check if a tmux session exists
# Arguments:
#   $1 - Session ID or session name
# Returns:
#   0 if session exists, 1 otherwise
#
_session_exists_in_tmux() {
  local session_id="$1"
  if [ -z "$session_id" ]; then return 1; fi
  
  local session_name
  session_name=$(_get_session_name_from_id "$session_id")
  
  tmux has-session -t "$session_name" 2>/dev/null
}

#
# _is_session_attached - Check if a tmux session is currently attached
# Arguments:
#   $1 - Session name
# Returns:
#   0 if attached, 1 if detached or session doesn't exist
#
_is_session_attached() {
  local session_name="$1"
  if [ -z "$session_name" ]; then return 1; fi
  
  local attached
  attached=$(tmux display-message -t "${session_name}:" -p '#{session_attached}' 2>/dev/null)
  
  if [ "$attached" == "1" ]; then
    return 0
  else
    return 1
  fi
}

#
# _cleanup_dead_sessions - Remove dead sessions from registry
# Scans sessions registry and removes entries for sessions that no longer exist in tmux
# Also cleans up associated temporary directories
#
_cleanup_dead_sessions() {
  local sessions_file tmp_file
  sessions_file=$(_get_sessions_file)
  tmp_file="${sessions_file}.tmp"
  
  if [ ! -f "$sessions_file" ]; then return; fi
  
  > "$tmp_file"
  while IFS='|' read -r reg_session_id creation_time last_activity status; do
    if [ -z "$reg_session_id" ]; then continue; fi
    
    # Extract just the session name (before @) for tmux check
    local session_name
    session_name=$(echo "$reg_session_id" | cut -d'@' -f1)
    
    if tmux has-session -t "$session_name" 2>/dev/null; then
      # Session still alive, keep in registry
      echo "${reg_session_id}|${creation_time}|${last_activity}|${status}" >> "$tmp_file"
    else
      # Session is dead, clean up its directory
      local session_dir="${tmp_path}/${reg_session_id}"
      if [ -d "$session_dir" ]; then
        rm -rf "$session_dir"
      fi
    fi
  done < "$sessions_file"
  
  if [ -s "$tmp_file" ]; then
    mv -f "$tmp_file" "$sessions_file"
  elif [ -f "$tmp_file" ]; then
    rm -f "$tmp_file"
    # If tmp_file is empty but original exists, clear original (all sessions dead)
    if [ -f "$sessions_file" ]; then
      : > "$sessions_file"
    fi
  fi
}

#
# _register_session - Register a new session or update existing one
# Arguments:
#   $1 - Session ID
#   $2 - Status (active|detached, default: active)
#
_register_session() {
  local session_id="$1"
  local status="${2:-active}"
  
  if [ -z "$session_id" ]; then return; fi
  
  _init_sessions_registry
  _cleanup_dead_sessions
  
  local sessions_file tmp_file current_time
  sessions_file=$(_get_sessions_file)
  tmp_file="${sessions_file}.tmp"
  current_time=$(date +%s)
  
  > "$tmp_file"
  local found=false
  while IFS='|' read -r reg_session_id creation_time last_activity reg_status; do
    if [ -z "$reg_session_id" ]; then continue; fi
    
    if [ "$reg_session_id" == "$session_id" ]; then
      # Update existing session
      echo "${session_id}|${creation_time}|${current_time}|${status}" >> "$tmp_file"
      found=true
    else
      # Keep other sessions unchanged
      echo "${reg_session_id}|${creation_time}|${last_activity}|${reg_status}" >> "$tmp_file"
    fi
  done < "$sessions_file"
  
  # Add new session if not found
  if [ "$found" == false ]; then
    echo "${session_id}|${current_time}|${current_time}|${status}" >> "$tmp_file"
  fi
  
  mv -f "$tmp_file" "$sessions_file"
}

#
# _unregister_session - Remove a session from registry
# Arguments:
#   $1 - Session ID
#
_unregister_session() {
  local session_id="$1"
  if [ -z "$session_id" ]; then return; fi
  
  local sessions_file tmp_file
  sessions_file=$(_get_sessions_file)
  tmp_file="${sessions_file}.tmp"
  
  if [ ! -f "$sessions_file" ]; then return; fi
  
  > "$tmp_file"
  while IFS='|' read -r reg_session_id creation_time last_activity reg_status; do
    if [ -z "$reg_session_id" ]; then continue; fi
    if [ "$reg_session_id" != "$session_id" ]; then
      echo "${reg_session_id}|${creation_time}|${last_activity}|${reg_status}" >> "$tmp_file"
    fi
  done < "$sessions_file"
  
  mv -f "$tmp_file" "$sessions_file"
  
  # Clean up session directory
  local session_dir="${tmp_path}/${session_id}"
  if [ -d "$session_dir" ]; then
    rm -rf "$session_dir"
  fi
}

#
# _get_latest_session - Get the most recently active session ID
# Returns:
#   Session ID of latest session, or empty if no sessions exist
#
_get_latest_session() {
  _init_sessions_registry
  _cleanup_dead_sessions
  
  local sessions_file
  sessions_file=$(_get_sessions_file)
  
  if [ ! -s "$sessions_file" ]; then
    echo ""
    return
  fi
  
  # Sort by last_activity (field 3) in descending order and get the first
  sort -t'|' -k3 -nr "$sessions_file" 2>/dev/null | head -1 | cut -d'|' -f1
}

#
# _get_next_session - Get next session in creation order (for cycling)
# Arguments:
#   $1 - Current session ID
# Returns:
#   Next session ID in creation order, or first session if current is last
#
_get_next_session() {
  local current_session="$1"
  
  _init_sessions_registry
  _cleanup_dead_sessions
  
  local sessions_file
  sessions_file=$(_get_sessions_file)
  
  if [ ! -s "$sessions_file" ]; then
    echo ""
    return
  fi
  
  # Get list of sessions sorted by creation time
  local sessions
  sessions=$(sort -t'|' -k2 -n "$sessions_file" 2>/dev/null | cut -d'|' -f1)
  
  if [ -z "$current_session" ]; then
    # No current session, return the first one
    echo "$sessions" | head -1
    return
  fi
  
  # Find current session and return next one
  local found=false
  local next_session=""
  while IFS= read -r session_id; do
    if [ "$found" == true ]; then
      next_session="$session_id"
      break
    fi
    if [ "$session_id" == "$current_session" ]; then
      found=true
    fi
  done <<< "$sessions"
  
  # If we reached the end, wrap around to first session
  if [ -z "$next_session" ]; then
    next_session=$(echo "$sessions" | head -1)
  fi
  
  echo "$next_session"
}

#
# _list_sessions - List all active sessions
# Output format: one session ID per line
#
_list_sessions() {
  _init_sessions_registry
  _cleanup_dead_sessions
  
  local sessions_file
  sessions_file=$(_get_sessions_file)
  
  if [ ! -s "$sessions_file" ]; then
    return
  fi
  
  cut -d'|' -f1 "$sessions_file"
}

#
# _list_sessions_detailed - List all sessions with detailed info
# Output format: SESSION_ID|CREATION_TIME|LAST_ACTIVITY|STATUS|ATTACHED
#
_list_sessions_detailed() {
  _init_sessions_registry
  _cleanup_dead_sessions
  
  local sessions_file
  sessions_file=$(_get_sessions_file)
  
  if [ ! -s "$sessions_file" ]; then
    return
  fi
  
  while IFS='|' read -r session_id creation_time last_activity status; do
    if [ -n "$session_id" ]; then
      local session_name attached
      session_name=$(_get_session_name_from_id "$session_id")
      if _is_session_attached "$session_name"; then
        attached="attached"
      else
        attached="detached"
      fi
      echo "${session_id}|${creation_time}|${last_activity}|${status}|${attached}"
    fi
  done < "$sessions_file"
}

# ============================================================================
# SESSION-AWARE PATH FUNCTIONS
# ============================================================================

#
# _get_session_tmp_dir - Get temporary directory for a session
# Arguments:
#   $1 - Session ID
# Returns:
#   Path to session's temporary directory
#
_get_session_tmp_dir() {
  local session_id="$1"
  if [ -z "$session_id" ]; then
    echo "$tmp_path"
  else
    echo "${tmp_path}/${session_id}"
  fi
}

#
# _get_monitor_file - Get monitor registry file path for a session
# Arguments:
#   $1 - Session ID (optional, defaults to legacy global path)
# Returns:
#   Path to monitor file
#
_get_monitor_file() {
  local session_id="$1"
  if [ -z "$session_id" ]; then
    # Fallback to legacy global monitor file
    echo "${tmp_path}/monitor"
  else
    echo "${tmp_path}/${session_id}/monitor"
  fi
}

#
# _prepare_session_tmp - Ensure session temporary directory exists
# Arguments:
#   $1 - Session ID
#
_prepare_session_tmp() {
  local session_id="$1"
  _prepare_tmp
  
  if [ -n "$session_id" ]; then
    local session_dir
    session_dir=$(_get_session_tmp_dir "$session_id")
    if [ ! -d "$session_dir" ]; then
      mkdir -p "$session_dir"
    fi
  fi
}

#
# _get_tmp_stdout - Get stdout temp file path
# Arguments:
#   $1 - Temporary index
#   $2 - Session ID (optional)
#
_get_tmp_stdout() {
  local tmp_index="$1"
  local session_id="$2"
  
  if [ -z "$tmp_index" ]; then return; fi
  
  local base_dir
  if [ -n "$session_id" ]; then
    base_dir=$(_get_session_tmp_dir "$session_id")
  else
    base_dir="$tmp_path"
  fi
  
  echo "${base_dir}/${tmp_index}.out"
}

#
# _get_tmp_stderr - Get stderr temp file path
# Arguments:
#   $1 - Temporary index
#   $2 - Session ID (optional)
#
_get_tmp_stderr() {
  local tmp_index="$1"
  local session_id="$2"
  
  if [ -z "$tmp_index" ]; then return; fi
  
  local base_dir
  if [ -n "$session_id" ]; then
    base_dir=$(_get_session_tmp_dir "$session_id")
  else
    base_dir="$tmp_path"
  fi
  
  echo "${base_dir}/${tmp_index}.err"
}

#
# _get_tmp_index - Generate unique temporary file index
# Arguments:
#   $1 - Session ID (optional, for session-scoped indexes)
# Returns:
#   Unique index number
#
_get_tmp_index() {
  local session_id="$1"
  local base_dir
  
  _prepare_tmp
  
  if [ -n "$session_id" ]; then
    _prepare_session_tmp "$session_id"
    base_dir=$(_get_session_tmp_dir "$session_id")
  else
    base_dir="$tmp_path"
  fi
  
  local loop_times=0
  while [ $loop_times -lt 32768 ]; do
    local base_index init_index tmp_index
    base_index=$(expr $loop_times \* 32768)
    init_index=$RANDOM
    tmp_index=$(expr "$(expr "$(expr $init_index + 1)" % 32768)" + $base_index)
    
    while [ ! "$tmp_index" = "$init_index" ]; do
      if [ ! -e "${base_dir}/${tmp_index}.out" -a ! -e "${base_dir}/${tmp_index}.err" ]; then
        echo "$tmp_index"
        return
      fi
      tmp_index=$(expr "$(expr $tmp_index + 1)" % 32768)
    done
    loop_times=$(expr $loop_times + 1)
  done
  
  echo ""
}


# ============================================================================
# MONITOR MANAGEMENT (SESSION-AWARE)
# ============================================================================

#
# _monitor_file_check - Validate and clean up monitor registry
# Removes dead monitors (processes that no longer exist)
# Arguments:
#   $1 - Session ID (optional)
#
_monitor_file_check() {
  local session_id="${1:-}"
  local monitor_file monitor_tmpfile
  
  _prepare_session_tmp "$session_id"
  monitor_file=$(_get_monitor_file "$session_id")
  monitor_tmpfile="${monitor_file}.tmp"
  
  # Initialize monitor file if needed
  if [ ! -f "$monitor_file" ]; then
    touch "$monitor_file"
    return
  fi
  
  # Remove stale tmpfile if exists
  rm -f "$monitor_tmpfile"
  
  # Check each monitor entry and clean up dead ones
  while IFS= read -r line || [ -n "$line" ]; do
    if [ -z "$line" ]; then continue; fi
    
    local file title pid tmp dead
    IFS="|" read -r file title pid tmp dead <<< "$line"
    
    if [ -z "$pid" ]; then
      # No PID associated, keep it
      echo "$line" >> "$monitor_tmpfile"
    else
      # Check if process is still alive
      if kill -0 "$pid" 2>/dev/null; then
        echo "$line" >> "$monitor_tmpfile"
      else
        # Process dead, clean up temp files
        if [ -n "$tmp" ]; then
          local tmp_stdout tmp_stderr
          tmp_stdout=$(_get_tmp_stdout "$tmp" "$session_id")
          tmp_stderr=$(_get_tmp_stderr "$tmp" "$session_id")
          rm -f "$tmp_stdout" "$tmp_stderr"
        fi
      fi
    fi
  done < "$monitor_file"
  
  # Replace original file with cleaned version
  if [ -f "$monitor_tmpfile" ]; then
    mv -f "$monitor_tmpfile" "$monitor_file"
  else
    # All entries were dead, create empty file
    : > "$monitor_file"
  fi
}

#
# _monitor_append - Append a monitor entry to registry
# Arguments:
#   $1 - File path
#   $2 - Title
#   $3 - PID
#   $4 - Temp index
#   $5 - Dead flag
#   $6 - Session ID (optional)
#
_monitor_append() {
  local session_id="${6:-}"
  local monitor_file
  
  _prepare_session_tmp "$session_id"
  monitor_file=$(_get_monitor_file "$session_id")
  
  if [ ! -f "$monitor_file" ]; then
    touch "$monitor_file"
  fi
  
  # Check for pipe characters in arguments
  if [ "$(_check_monitor_arg "$@")" -ne 0 ]; then return; fi
  
  (IFS="|"; echo "$1|$2|$3|$4|$5" >> "$monitor_file")
}

#
# _monitor_clear - Clear all monitors for a session
# Optionally preserves monitors with running processes
# Arguments:
#   $1 - Session ID (optional)
#
_monitor_clear() {
  local session_id="${1:-}"
  local monitor_file
  
  monitor_file=$(_get_monitor_file "$session_id")
  
  if [ ! -f "$monitor_file" ]; then
    # Clean up empty session directory
    if [ -n "$session_id" ]; then
      local session_dir
      session_dir=$(_get_session_tmp_dir "$session_id")
      if [ -d "$session_dir" ]; then
        rm -rf "$session_dir"
      fi
    fi
    return
  fi
  
  # Collect monitors with running processes
  local preserved=()
  local preserved_tmp=()
  
  while IFS= read -r line; do
    if [ -z "$(echo "$line" | tr -d '[:space:]')" ]; then continue; fi
    
    local file title pid tmp dead
    IFS="|" read -r file title pid tmp dead <<< "$line"
    
    if [ -n "$pid" ]; then
      if kill -0 "$pid" 2>/dev/null; then
        preserved=("${preserved[@]}" "$file|$title|$pid|$tmp|dead")
        if [ -n "$tmp" ]; then
          local tmp_stdout tmp_stderr
          tmp_stdout=$(_get_tmp_stdout "$tmp" "$session_id")
          tmp_stderr=$(_get_tmp_stderr "$tmp" "$session_id")
          preserved_tmp=("${preserved_tmp[@]}" "$(basename "$tmp_stdout")" "$(basename "$tmp_stderr")")
        fi
      fi
    fi
  done < <(cat "$monitor_file" 2>/dev/null; echo)
  
  # Clean up temp files not preserved
  local session_dir
  session_dir=$(_get_session_tmp_dir "$session_id")
  
  find "$session_dir" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | while read -r file; do
    local file_base found
    file_base="$(basename "$file")"
    found=false
    
    for preserved_file in "${preserved_tmp[@]}"; do
      if [ "$file_base" == "$preserved_file" ]; then
        found=true
        break
      fi
    done
    
    if [ "$found" != true ]; then
      rm -f "$file"
    fi
  done
  
  # Write preserved monitors back
  > "$monitor_file"
  for line in "${preserved[@]}"; do
    echo "$line" >> "$monitor_file"
  done
}

#
# _get_monitored_files - Get all monitored files for a session
# Arguments:
#   $1 - Session ID (optional)
# Output: One monitor record per line (pipe-delimited)
#
_get_monitored_files() {
  local session_id="${1:-}"
  local monitor_file
  
  monitor_file=$(_get_monitor_file "$session_id")
  
  if [ ! -f "$monitor_file" ]; then
    return
  fi
  
  _monitor_file_check "$session_id"
  
  (cat "$monitor_file" 2>/dev/null && echo) | while IFS= read -r line || [ -n "$line" ]; do
    if [ -n "$line" ]; then
      # Skip dead entries (entries with dead flag set)
      local dead_flag
      dead_flag=$(echo "$line" | awk -F'|' '{print $5}')
      if [ -z "$dead_flag" ]; then
        echo "$line"
      fi
    fi
  done
}

# ============================================================================
# SESSION RESOLUTION HELPERS
# ============================================================================

#
# _resolve_session_open - Resolve session for open/exec/monitor commands
# Rules:
#   - If -S specified: use that session (create if needed)
#   - If inside tmux: use current session
#   - Otherwise: use latest session (don't attach here, caller handles it)
# Arguments:
#   $1 - Specified session ID (may be empty)
#   $2 - Whether to create new session if none exists (true/false)
# Returns:
#   Session ID on stdout (with "CREATED:" prefix if new session was created),
#   or empty if resolution failed
#
_resolve_session_open() {
  local specified_session="$1"
  local create_if_needed="${2:-true}"
  
  if [ -n "$specified_session" ]; then
    # User specified a session
    if _session_exists_in_tmux "$specified_session"; then
      echo "$specified_session"
      return
    elif [ "$create_if_needed" == true ]; then
      # Create new session with specified ID using _start_session for proper styling
      local session_name session_id
      session_name=$(_get_session_name_from_id "$specified_session")
      session_id=$(_start_session "$session_name")
      if [ -n "$session_id" ]; then
        echo "CREATED:${session_id}"
        return
      fi
    fi
    echo ""
    return
  fi
  
  # Check if we're inside tmux
  local current_session
  current_session=$(_get_current_session_id)
  
  if [ -n "$current_session" ]; then
    # Use current session
    echo "$current_session"
    return
  fi
  
  # Not in tmux, try to use latest session (don't attach here - caller will handle)
  local latest_session
  latest_session=$(_get_latest_session)
  
  if [ -n "$latest_session" ]; then
    # Return the session ID - caller will attach if needed
    echo "$latest_session"
    return
  fi
  
  # No sessions exist, create new one if allowed
  if [ "$create_if_needed" == true ]; then
    local session_id
    session_id=$(_start_session)
    if [ -n "$session_id" ]; then
      echo "CREATED:${session_id}"
      return
    fi
  fi
  
  echo ""
}

#
# _resolve_session_kill_clear - Resolve session for kill/clear commands
# Rules:
#   - If -S specified: use that session
#   - If inside tmux: use current session
#   - Otherwise: use latest session
#   - Never create new session
# Arguments:
#   $1 - Specified session ID (may be empty)
# Returns:
#   Session ID on stdout, or empty if no session found
#
_resolve_session_kill_clear() {
  local specified_session="$1"
  
  if [ -n "$specified_session" ]; then
    if _session_exists_in_tmux "$specified_session"; then
      echo "$specified_session"
    else
      echo ""
    fi
    return
  fi
  
  # Check if we're inside tmux
  local current_session
  current_session=$(_get_current_session_id)
  
  if [ -n "$current_session" ]; then
    echo "$current_session"
    return
  fi
  
  # Use latest session
  _get_latest_session
}

#
# _resolve_session_ps - Resolve session for ps command
# Rules:
#   - If -S specified: use that session only
#   - Otherwise: all sessions (return empty string to indicate "all")
# Arguments:
#   $1 - Specified session ID (may be empty)
# Returns:
#   Session ID, or empty to indicate "all sessions"
#
_resolve_session_ps() {
  local specified_session="$1"
  
  if [ -n "$specified_session" ]; then
    if _session_exists_in_tmux "$specified_session"; then
      echo "$specified_session"
    else
      echo ""
    fi
    return
  fi
  
  # Empty means "all sessions"
  echo ""
}

# ============================================================================
# TMUX SESSION OPERATIONS
# ============================================================================

#
# _start_session - Create a new tmux session
# Arguments:
#   $1 - Session name (optional, auto-generated if not provided)
# Returns:
#   Session ID on stdout
#
_start_session() {
  local session_name="$1"
  
  if [ -z "$session_name" ]; then
    session_name="tmon$RANDOM"
  fi
  
  # Create detached session
  tmux new-session -d -s "$session_name"
  
  # Configure session appearance
  tmux set -t "$session_name" status-style "bg=black,fg=green"
  tmux set -t "$session_name" pane-border-format "#{pane_title}"
  tmux set -t "$session_name" pane-border-status top
  tmux set -t "$session_name" mouse on
  
  echo "${session_name}@0"
}

#
# _attach_session - Attach to a tmux session
# Arguments:
#   $1 - Session ID
# Returns:
#   0 on success, 1 on failure
#
_attach_session() {
  local session_id="$1"
  local session_name
  
  session_name=$(_get_session_name_from_id "$session_id")
  tmux attach-session -t "$session_name" 2>/dev/null
}

#
# _detach_session - Detach from a tmux session
# Arguments:
#   $1 - Session ID (optional, uses current if not specified)
#
_detach_session() {
  local session_id="$1"
  local session_name
  
  if [ -n "$session_id" ]; then
    session_name=$(_get_session_name_from_id "$session_id")
    tmux detach-client -s "$session_name" 2>/dev/null
  else
    tmux detach-client 2>/dev/null
  fi
}

#
# _kill_session - Kill a tmux session
# Arguments:
#   $1 - Session ID
#
_kill_session() {
  local session_id="$1"
  local session_name
  
  if [ -z "$session_id" ]; then return; fi
  
  session_name=$(_get_session_name_from_id "$session_id")
  tmux kill-session -t "$session_name" 2>/dev/null
  
  # Clean up registry
  _unregister_session "$session_id"
}

# ============================================================================
# TMUX PANE OPERATIONS (SESSION-AWARE)
# ============================================================================

#
# _get_window_width - Get window width for a session
# Arguments:
#   $1 - Session ID
#
_get_window_width() {
  local session_id="$1"
  local session_name
  
  session_name=$(_get_session_name_from_id "$session_id")
  tmux display-message -t "${session_name}:" -p '#{window_width}' 2>/dev/null
}

#
# _set_layout - Set pane layout for a session
# Arguments:
#   $1 - Session ID
#
_set_layout() {
  local session_id="$1"
  local session_name window_id
  
  session_name=$(_get_session_name_from_id "$session_id")
  window_id=$(_get_window_id_from_id "$session_id")
  
  # Select main-vertical layout
  tmux select-layout -t "${session_name}:${window_id}" main-vertical
  
  # Select pane 0 and clear its title (pane 0 should have empty title)
  tmux select-pane -t "${session_name}:${window_id}.0"
  tmux select-pane -t "${session_name}:${window_id}.0" -T ""
  
  # Resize pane 0 to 50% width
  tmux resize-pane -t "${session_name}:${window_id}.0" -x 50% 2>/dev/null
  
  if [ $? -ne 0 ]; then
    local width
    width=$(_get_window_width "$session_id")
    if [ -n "$width" ]; then
      tmux resize-pane -t "${session_name}:${window_id}.0" -x "$(expr "${width}" / 2)"
    fi
  fi
  
  # Ensure pane 0 is the active pane after layout
  tmux select-pane -t "${session_name}:${window_id}.0"
}

#
# _find_panes_by_title - Find pane IDs by title pattern
# Arguments:
#   $1 - Title pattern to search for
#   $2 - Session ID
# Returns:
#   Pane IDs (one per line) that match the pattern
#
_find_panes_by_title() {
  local title_pattern="$1"
  local session_id="$2"
  local session_name
  
  if [ -z "$title_pattern" ]; then return; fi
  
  session_name=$(_get_session_name_from_id "$session_id")
  tmux list-panes -t "${session_name}:" -F "#P:#T" 2>/dev/null | \
    grep -E "^[0-9]+:.*?${title_pattern}.*$" | \
    sed "s/:.*//g"
}

#
# _kill_pane - Kill a specific pane in a session
# Arguments:
#   $1 - Pane index
#   $2 - Session ID
#
_kill_pane() {
  local pane_index="$1"
  local session_id="$2"
  local session_name window_id
  
  session_name=$(_get_session_name_from_id "$session_id")
  window_id=$(_get_window_id_from_id "$session_id")
  # Target format: session:window.pane (e.g., mysession:0.1 for window 0, pane 1)
  tmux kill-pane -t "${session_name}:${window_id}.${pane_index}" 2>/dev/null
}

#
# _kill_all_panes_except_first - Kill all panes except pane 0
# Arguments:
#   $1 - Session ID
#
_kill_all_panes_except_first() {
  local session_id="$1"
  local session_name window_id
  
  session_name=$(_get_session_name_from_id "$session_id")
  window_id=$(_get_window_id_from_id "$session_id")
  
  # First swap current pane to 0 if needed
  local current_pane_id
  current_pane_id=$(_current_pane "$session_id")
  if [ "$current_pane_id" != "0" ] && [ "$current_pane_id" != "-1" ]; then
    tmux swap-pane -U -t "${session_name}:${window_id}" 2>/dev/null
  fi
  
  # Kill all panes except 0
  tmux kill-pane -a -t "${session_name}:${window_id}.0" 2>/dev/null
}

#
# _split_window - Split window to create a new pane
# Arguments:
#   $1 - Split arguments (e.g., "-v" or "-h -p 50")
#   $2 - Command to run in new pane
#   $3 - Session ID
# Returns:
#   The index of the newly created pane
#
_split_window() {
  local split_args="$1"
  local command="$2"
  local session_id="$3"
  local session_name
  
  session_name=$(_get_session_name_from_id "$session_id")
  
  # Split the window and capture the new pane index
  # Use -P to print the pane_id, then convert to index
  local new_pane_id
  new_pane_id=$(tmux split-window -t "${session_name}:" -P -F "#{pane_id}" $split_args "$command")
  
  # Get the pane index from the pane_id
  local new_pane_index
  new_pane_index=$(tmux list-panes -t "${session_name}:" -F "#{pane_index}@#{pane_id}" | grep "@${new_pane_id}$" | cut -d'@' -f1)
  
  echo "$new_pane_index"
}

#
# _select_pane - Select a pane and optionally set its title
# Arguments:
#   $1 - Pane index
#   $2 - Session ID
#   $3 - Title (optional)
#
_select_pane() {
  local pane_index="$1"
  local session_id="$2"
  local title="${3:-}"
  local session_name window_id
  
  session_name=$(_get_session_name_from_id "$session_id")
  window_id=$(_get_window_id_from_id "$session_id")
  
  # Target format: session:window.pane (e.g., mysession:0.1 for window 0, pane 1)
  if [ -n "$title" ]; then
    tmux select-pane -t "${session_name}:${window_id}.${pane_index}" -T "$title"
  else
    tmux select-pane -t "${session_name}:${window_id}.${pane_index}"
  fi
}

#
# _current_pane - Get current pane ID in a session
# Arguments:
#   $1 - Session ID (optional, uses current if not specified)
# Returns:
#   Pane ID, or -1 if not in tmux
#
_current_pane() {
  local session_id="$1"
  
  if [ -n "$session_id" ]; then
    local session_name
    session_name=$(_get_session_name_from_id "$session_id")
    tmux display-message -t "${session_name}:" -p '#{pane_index}' 2>/dev/null
  else
    if [ -z "$TMUX_PANE" ]; then
      echo -1
    else
      tmux list-panes -F "#P@#D" | grep "@$TMUX_PANE" | sed "s/@$TMUX_PANE//g"
    fi
  fi
}

# ============================================================================
# LEGACY COMPATIBILITY FUNCTIONS
# ============================================================================

#
# in_session - Check if we're inside a tmux session
# Returns:
#   1 if inside tmux, 0 otherwise
#
in_session() {
  if [ -n "$TMUX" ]; then echo 1; else echo 0; fi
}

#
# is_attached - Check if current or specified session is attached
# Arguments:
#   $1 - Session name (optional)
# Returns:
#   1 if attached, 0 if detached
#
is_attached() {
  local session_name="$1"
  
  if [ -z "$session_name" ]; then
    session_name=$(tmux display -p '#{session_name}' 2>/dev/null) || session_name=""
    if [ -z "$session_name" ]; then
      echo 0
      return
    fi
  fi
  
  local attached
  attached=$(tmux display-message -t "${session_name}:" -p '#{session_attached}' 2>/dev/null)
  
  if [ "$attached" == "1" ]; then
    echo 1
  else
    echo 0
  fi
}

#
# current_pane - Get current pane index
# Returns:
#   Pane index, or -1 if not in tmux
#
current_pane() {
  if [ -z "$TMUX_PANE" ]; then
    echo -1
  else
    tmux list-panes -F "#P@#D" | grep "@$TMUX_PANE" | sed "s/@$TMUX_PANE//g"
  fi
}

#
# exit_session - Exit current tmux session
#
exit_session() {
  if [ "$(in_session)" == "1" ]; then
    tmux kill-session
  fi
}

# ============================================================================
# TITLE AND DISPLAY FUNCTIONS
# ============================================================================

#
# _get_pane_title - Generate formatted pane title
# Arguments:
#   $1 - Title text
#   $2 - Session ID (for calculating width)
# Returns:
#   Formatted title string
#
_get_pane_title() {
  local title="$1"
  local session_id="$2"
  
  if [ -z "$title" ]; then
    echo ""
    return
  fi
  
  local width max_title_size
  width=$(_get_window_width "$session_id")
  max_title_size=$(expr "$(expr "$width" / 2)" - 5)
  
  if [ "$max_title_size" -gt 4 ]; then
    local truncated
    truncated=$(echo "$title" | cut -c "-$(expr $max_title_size - 4)")
    echo "[ $truncated ]"
  else
    echo "$title" | cut -c "-$max_title_size"
  fi
}

#
# _kill_process - Kill processes with specified command
# Arguments:
#   $1 - Kill command (e.g., "kill" or "sudo kill")
#   $@ - PIDs to kill
# Returns:
#   0 on success, 1 on failure
#
_kill_process() {
  local kill_command="$1"
  shift
  local success=true
  
  while [ $# -gt 0 ]; do
    if ! $kill_command "$1" >/dev/null 2>/dev/null; then
      if $kill_command -0 "$1" >/dev/null 2>/dev/null; then
        success=false
      fi
    fi
    shift
  done
  
  if [ "$success" == true ]; then
    return 0
  else
    return 1
  fi
}


# ============================================================================
# COMMAND: tmon session
# Session management operations
# ============================================================================

#
# _tmon_session_help - Show help for session command
#
_tmon_session_help() {
  printf '%s\n' 'tmon session [SUBCOMMAND] [OPTIONS]' \
                '' \
                'Manage tmon sessions.' \
                '' \
                'Subcommands:' \
                '  current            Show current session ID.' \
                '  list               List all active sessions (one per line).' \
                '  create [-d] [NAME] Create a new session. Use -d to run detached.' \
                '  attach [ID]        Attach to a session (latest if no ID specified).' \
                '  detach             Detach from current session.' \
                '  switch [ID]        Switch to another session (cycles if no ID).' \
                '  kill [ID]          Kill a session (current if no ID specified).' \
                '  cleanup            Remove dead sessions from registry.' \
                '' \
                '  -h, --help         Display this help and exit.' \
                '' \
                'Examples:' \
                '  tmon session current              Show current session.' \
                '  tmon session list                 List all sessions.' \
                '  tmon session create mysession     Create and attach to new session.' \
                '  tmon session create -d mysession  Create detached session.' \
                '  tmon session switch               Cycle to next session.' \
                '  tmon session switch mysession@0   Switch to specific session.' \
                ''
  exit
}

#
# tmon_session - Main session command handler
#
tmon_session() {
  local subcommand=""
  local detach=false
  local args=()
  
  # Parse arguments
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        _tmon_session_help
        ;;
      -d|--detach)
        detach=true
        shift
        ;;
      --)
        shift
        ;;
      *)
        if [ -z "$subcommand" ]; then
          subcommand="$1"
        else
          args+=("$1")
        fi
        shift
        ;;
    esac
  done
  
  case "$subcommand" in
    current)
      _tmon_session_current
      ;;
    list)
      _tmon_session_list
      ;;
    create)
      _tmon_session_create "$detach" "${args[@]}"
      ;;
    attach)
      _tmon_session_attach "${args[@]}"
      ;;
    detach)
      _tmon_session_detach
      ;;
    switch)
      _tmon_session_switch "${args[@]}"
      ;;
    kill|close)
      _tmon_session_kill "${args[@]}"
      ;;
    cleanup|clean)
      _tmon_session_cleanup
      ;;
    "")
      _tmon_session_help
      ;;
    *)
      echo "Unknown subcommand: $subcommand" >&2
      _tmon_session_help
      ;;
  esac
}

#
# _tmon_session_current - Show current session ID
#
_tmon_session_current() {
  local session_id
  session_id=$(_get_current_session_id)
  
  if [ -n "$session_id" ]; then
    echo "$session_id"
  else
    echo "Not in a tmux session."
    return 1
  fi
}

#
# _tmon_session_list - List all sessions
#
_tmon_session_list() {
  _init_sessions_registry
  _cleanup_dead_sessions
  
  local sessions_file
  sessions_file=$(_get_sessions_file)
  
  if [ ! -s "$sessions_file" ]; then
    echo "No active sessions."
    return
  fi
  
  _list_sessions
}

#
# _tmon_session_create - Create a new session
# Arguments:
#   $1 - Detach flag (true/false)
#   $2 - Session name (optional)
#
_tmon_session_create() {
  local detach="${1:-false}"
  shift
  local session_name="${1:-}"
  local session_id
  
  # Generate session name if not provided
  if [ -z "$session_name" ]; then
    session_name="tmon$RANDOM"
  fi
  
  # Check if session already exists
  if tmux has-session -t "$session_name" 2>/dev/null; then
    echo "Session '$session_name' already exists." >&2
    return 1
  fi
  
  # Create session
  session_id=$(_start_session "$session_name")
  
  # Register session
  _register_session "$session_id" "active"
  
  echo "Created session: $session_id"
  
  # Attach unless detach flag is set
  if [ "$detach" != true ]; then
    # If we're in a session, detach first
    if [ "$(in_session)" == "1" ]; then
      tmux detach-client 2>/dev/null
    fi
    _attach_session "$session_id"
  fi
}

#
# _tmon_session_attach - Attach to a session
# Arguments:
#   $1 - Session ID (optional, uses latest if not specified)
#
_tmon_session_attach() {
  local session_id="${1:-}"
  
  if [ -z "$session_id" ]; then
    session_id=$(_get_latest_session)
  fi
  
  if [ -z "$session_id" ]; then
    echo "No sessions found. Create one with 'tmon session create'." >&2
    return 1
  fi
  
  if ! _session_exists_in_tmux "$session_id"; then
    echo "Session '$session_id' not found." >&2
    return 1
  fi
  
  # Update session activity
  _register_session "$session_id" "active"
  
  # If we're in a session, detach first
  if [ "$(in_session)" == "1" ]; then
    tmux detach-client 2>/dev/null
  fi
  
  _attach_session "$session_id"
}

#
# _tmon_session_detach - Detach from current session
#
_tmon_session_detach() {
  local current_session
  current_session=$(_get_current_session_id)
  
  if [ -z "$current_session" ]; then
    echo "Not in a tmux session." >&2
    return 1
  fi
  
  _register_session "$current_session" "detached"
  _detach_session
}

#
# _tmon_session_switch - Switch to another session
# Arguments:
#   $1 - Target session ID (optional, cycles to next if not specified)
#
_tmon_session_switch() {
  local target_session="${1:-}"
  local current_session
  
  current_session=$(_get_current_session_id)
  
  if [ -z "$target_session" ]; then
    # Cycle to next session
    target_session=$(_get_next_session "$current_session")
    
    if [ -z "$target_session" ]; then
      echo "No sessions to switch to." >&2
      return 1
    fi
    
    if [ "$target_session" == "$current_session" ]; then
      echo "No other sessions available." >&2
      return 1
    fi
  fi
  
  if ! _session_exists_in_tmux "$target_session"; then
    echo "Session '$target_session' not found." >&2
    return 1
  fi
  
  # Mark current session as detached if we're in one
  if [ -n "$current_session" ]; then
    _register_session "$current_session" "detached"
    tmux detach-client 2>/dev/null
  fi
  
  # Activate target session
  _register_session "$target_session" "active"
  _attach_session "$target_session"
}

#
# _tmon_session_kill - Kill a session
# Arguments:
#   $1 - Session ID (optional, uses current or latest if not specified)
#
_tmon_session_kill() {
  local session_id="${1:-}"
  local is_current=false
  
  if [ -z "$session_id" ]; then
    # Try current session first
    session_id=$(_get_current_session_id)
    if [ -n "$session_id" ]; then
      is_current=true
    else
      # Fall back to latest
      session_id=$(_get_latest_session)
    fi
  fi
  
  if [ -z "$session_id" ]; then
    echo "No session to kill." >&2
    return 1
  fi
  
  if ! _session_exists_in_tmux "$session_id"; then
    # Clean up registry anyway
    _unregister_session "$session_id"
    echo "Session '$session_id' was already dead. Cleaned up registry."
    return
  fi
  
  local session_name
  session_name=$(_get_session_name_from_id "$session_id")
  
  # Kill the tmux session
  tmux kill-session -t "$session_name" 2>/dev/null
  
  # Clean up registry
  _unregister_session "$session_id"
  
  echo "Killed session: $session_id"
  
  # If we killed the current session and there are other sessions, switch to latest
  if [ "$is_current" == true ]; then
    local latest
    latest=$(_get_latest_session)
    if [ -n "$latest" ]; then
      _attach_session "$latest"
    fi
  fi
}

#
# _tmon_session_cleanup - Clean up dead sessions from registry
#
_tmon_session_cleanup() {
  _init_sessions_registry
  _cleanup_dead_sessions
  echo "Cleaned up dead sessions."
}

